{
  "name": "dsh-chat-edit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Per-turn conversation editing: edit a sent prompt and resend it on a clean branch, or delete a turn and everything after it by forking before it.",
  "keywords": ["deepseek", "deepseek-harness", "dsh", "dsh-plugin", "conversation", "edit", "fork", "ui"],
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
